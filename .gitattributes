# 统一行尾：服务器上跑的一切都用 LF，Windows 批处理保留 CRLF。
# 上游仓库没有这个文件，Windows 下 clone 会把 .sh 转成 CRLF，scp 到 Linux 直接执行会报
# "bad interpreter: /usr/bin/env bash^M"。
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.conf  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.sql   text eol=lf
Dockerfile text eol=lf
*.excalidraw text eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.mp4   binary
*.zip   binary
*.pt    binary
*.onnx  binary
*.ksplat binary
*.ply   binary
*.excalidraw.png binary
